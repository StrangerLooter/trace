# TRACE Frontend (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_BACKEND_ESCALATION=false

# TRACE Backend (apps/api)
TRACE_ENV=development
TRACE_SCRATCH_DIR=/tmp/trace-jobs
TRACE_MAX_UPLOAD_MB=100
TRACE_JOB_TTL_SECONDS=600
TRACE_PARSER_TIMEOUT_SECONDS=15
TRACE_ALLOWED_ORIGINS=http://localhost:3000
